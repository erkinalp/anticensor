{
    "name": "harmony-server",
    "version": "1.0.0",
    "description": "A Harmony server written in Node.js",
    "scripts": {
        "prepare": "husky install",
        "postinstall": "patch-package",
        "start": "node --enable-source-maps  --trace-deprecation dist/bundle/start.js",
        "start:api": "node --enable-source-maps dist/api/start.js",
        "makeWebRTCToken": "node --enable-source-maps dist/util/scripts/makeWebRTCToken.js",
        "start:cdn": "node --enable-source-maps dist/cdn/start.js",
        "start:gateway": "node --enable-source-maps dist/gateway/start.js",
        "start:webrtc": "node --enable-source-maps dist/webrtc/start.js",
        "build": "npm run build:src && npm run generate:schema && npm run generate:openapi",
        "build:src": "tsc -b -v",
        "build:tsgo": "npm run build:src:tsgo && npm run generate:schema && npm run generate:openapi",
        "build:src:tsgo": "rm -rf dist/* tsconfig.tsbuildinfo && tsgo -b -v",
        "watch": "tsc -w -b .",
        "test": "node --no-strip-types --test \"dist/**/*.test.js\"",
        "lint": "eslint . --ignore-pattern 'cruft/**' --ignore-pattern 'node_temp/**' --cache",
        "setup": "npm run build && npm run generate:schema",
        "sync:db": "npm run build && node  --enable-source-maps scripts/syncronise.js",
        "generate:rights": "node --enable-source-maps scripts/rights.js",
        "generate:schema": "node --enable-source-maps scripts/schema.mjs",
        "generate:migration": "node   --enable-source-maps node_modules/typeorm/cli.js migration:generate -d dist/util/util/Database.js",
        "generate:openapi": "node    --enable-source-maps scripts/openapi.js",
        "add:license": "node    --enable-source-maps scripts/license.js",
        "node:tests": "npm run build:src:tsgo && node   --enable-source-maps --test --experimental-test-coverage dist/**/*.test.js",
        "apply:migrations": "node --enable-source-maps dist/apply-migrations.js"
    },
    "main": "dist/bundle/index.js",
    "types": "src/bundle/index.ts",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://codeberg.org/MelodyChat/Harmony.git"
    },
    "author": "MelodyChat",
    "license": "AGPL-3.0-only",
    "bugs": {
        "url": "https://codeberg.org/MelodyChat/Harmony/issues"
    },
    "imports": {
        "#harmony/api": "./dist/api/index.js",
        "#harmony/cdn": "./dist/cdn/index.js",
        "#harmony/gateway": "./dist/gateway/index.js",
        "#harmony/util": "./dist/util/index.js",
        "#harmony/webrtc": "./dist/webrtc/index.js",
        "#harmony/schemas": "./dist/schemas/index.js",
        "#lambert-server": "./dist/util/util/lambert-server/index.js",
        "#*": "./dist/*/index.js"
    },
    "homepage": "https://redir.fermi.chat/home",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.14.0",
        "@types/amqplib": "^0.10.8",
        "@types/bcrypt": "^6.0.0",
        "@types/body-parser": "^1.19.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/json-bigint": "^1.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^24.12.0",
        "@types/nodemailer": "^7.0.11",
        "@types/probe-image-size": "^7.2.5",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "@typescript-eslint/parser": "^8.57.2",
        "@typescript/native-preview": "^7.0.0-dev.20260119.1",
        "eslint": "^9.39.4",
        "globals": "^16.5.0",
        "harmony-webrtc-types": "^1.0.1",
        "husky": "^9.1.7",
        "patch-package": "^8.0.1",
        "prettier": "^3.8.1",
        "pretty-quick": "^4.2.2",
        "typescript": "^5.9.3",
        "typescript-json-schema": "^0.65.1"
    },
    "dependencies": {
        "@toondepauw/node-zstd": "^1.2.0",
        "ajv": "^8.18.0",
        "ajv-formats": "^3.0.1",
        "amqplib": "^0.10.9",
        "badge-maker": "^5.0.2",
        "bcrypt": "^6.0.0",
        "body-parser": "^2.2.2",
        "chalk": "^5.6.2",
        "cheerio": "^1.2.0",
        "cookie-parser": "^1.4.7",
        "discord-protos": "^1.2.143",
        "email-providers": "^2.22.0",
        "exif-be-gone": "^1.5.1",
        "express": "^5.2.1",
        "fast-zlib": "^2.0.1",
        "fido2-lib": "^3.5.9",
        "form-data": "^4.0.5",
        "harmony-erlpack": "^0.0.3",
        "harmony-pion-webrtc": "^1.1.3",
        "harmony-storage": "^1.0.0",
        "harmony.env": "^0.0.3",
        "image-size": "^2.0.2",
        "json-bigint": "^1.0.0",
        "jsonwebtoken": "^9.0.3",
        "mime-detect": "^1.3.0",
        "morgan": "^1.10.1",
        "ms": "^2.1.3",
        "multer": "^2.1.1",
        "node-2fa": "^2.0.3",
        "pg": "^8.23.0",
        "pg-query-stream": "^4.17.0",
        "picocolors": "^1.1.1",
        "probe-image-size": "^7.2.3",
        "tslib": "^2.8.1",
        "typeorm": "^1.0.0",
        "undici": "^8.6.0",
        "wretch": "^2.11.1",
        "ws": "^8.21.1"
    },
    "optionalDependencies": {
        "@sendgrid/mail": "^8.1.6",
        "canvas": "^3.2.3",
        "harmony-s3": "^1.0.0",
        "mailgun.js": "^12.7.1",
        "node-mailjet": "^6.0.11",
        "nodemailer": "^7.0.13"
    },
    "overrides": {
        "typeorm": {
            "better-sqlite3": "../_EXCLUDED_",
            "sqlite3": "../_EXCLUDED_",
            "mongodb": "../_EXCLUDED_"
        }
    }
}
